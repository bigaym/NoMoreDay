    container.Update(5.0f);
    CHECK(container.effects[0].remaining == 5.0f);
    container.AddOrRefresh(b1);
    CHECK(container.effects[0].remaining == 10.0f); // Duration reset
    CHECK(container.effects[0].stacks == 3);        // Stack increased

