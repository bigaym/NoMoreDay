        itemPool.name = "Item Only";
        itemPool.entries = { { LootEntryType::Item, 0, 1, 1, 100.0f } };
        ItemFactory::addLootPool(2, itemPool);
        
        registry.emplace<DropTableComponent>(victim, 2, 1.0f, 10, 10); // 10 items
