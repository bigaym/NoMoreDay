<file path="assets/shaders/particle.vert">
#version 430

layout(location = 0) in vec2 vertexPos; // Unit quad vertex [-0.5, 0.5]

struct Particle {
    vec2 position;
    vec2 velocity;
    vec2 acceleration;
    uint color;
    float lifetime;
    float maxLifetime;
    float scale;
    uint flags;
    float padding;
};

layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

uniform mat4 mvp;

out vec4 fragColor;
out flat uint vFlags; // Pass flags to frag
out vec2 vTexCoord;   // Pass UVs (derived from vertexPos)

void main() {
    uint id = gl_InstanceID;
    Particle p = particles[id];
    
    if (p.lifetime <= 0.0 || p.scale <= 0.0) {
        // Discard by moving out of clip space
        gl_Position = vec4(-10.0, -10.0, 0.0, 1.0);
        return;
    }

    // Unpack RGBA8 color from uint
    // Raylib Color is { r, g, b, a }, as uint (little endian) it's 0xAABBGGRR
    vec4 col = vec4(
        float(p.color & 0xFFu) / 255.0,
        float((p.color >> 8) & 0xFFu) / 255.0,
        float((p.color >> 16) & 0xFFu) / 255.0,
        float((p.color >> 24) & 0xFFu) / 255.0
    );
    
    // Simple fade out
    col.a *= (p.lifetime / p.maxLifetime);
    fragColor = col;
    vFlags = p.flags;
    vTexCoord = vertexPos + 0.5; // Map [-0.5, 0.5] to [0.0, 1.0]

    // Instance transform
    vec2 worldPos = vertexPos * p.scale + p.position;
    gl_Position = mvp * vec4(worldPos, 0.0, 1.0);
}
</file>

<file path="assets/shaders/physics.compute">
#version 430

layout(local_size_x = 256) in;

struct Entity {
    vec2 position;
    vec2 velocity;
    float radius;
    int type;
    int id;
    float padding;
};

layout(std430, binding = 1) buffer EntityBuffer { Entity entities[]; };
layout(std430, binding = 2) buffer CellCountBuffer { uint cellCounts[]; };
layout(std430, binding = 3) buffer CellOffsetBuffer { uint cellOffsets[]; };
layout(std430, binding = 4) buffer EntityIndicesBuffer { uint entityIndices[]; };

uniform float dt;
uniform int maxEntities;
uniform float cellSize;
uniform int gridCols;
uniform int gridRows;

layout(binding = 0) uniform sampler2D flowField;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= maxEntities || entities[id].radius <= 0.0) return;

    vec2 pos = entities[id].position;
    vec2 vel = entities[id].velocity;
    float radius = entities[id].radius;

    // 0. Steering (Flow Field) - Only for Enemies (type != 0)
    if (entities[id].type != 0) {
        vec2 worldSize = vec2(gridCols, gridRows) * cellSize;
        vec2 uv = pos / worldSize;
        
        // Ensure UV is clamped to avoid sampling outside the flow field
        uv = clamp(uv, vec2(0.0), vec2(1.0));
        
        vec2 flowDir = texture(flowField, uv).xy;
        
        // Apply steering force if there's a valid flow
        if (length(flowDir) > 0.01) {
            float speed = 150.0; // Desired movement speed for enemies
            float steerForce = 400.0;
            
            vec2 desiredVel = flowDir * speed;
            vec2 steer = desiredVel - vel;
            // Apply steering force smoothly
            vel += steer * steerForce * dt * 0.1; 
        }
    }

    // 1. Collision Detection (Spatial Hash Grid)
    // Only resolve collisions if the entity has a valid radius
    int cx = int(pos.x / cellSize);
    int cy = int(pos.y / cellSize);

    // Check 9 neighboring cells
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            int ncx = cx + x;
            int ncy = cy + y;
            if (ncx < 0 || ncx >= gridCols || ncy < 0 || ncy >= gridRows) continue;

            uint cellIdx = ncy * gridCols + ncx;
            uint offset = cellOffsets[cellIdx];
            uint count = cellCounts[cellIdx];

            for (uint i = 0; i < count; i++) {
                uint neighborId = entityIndices[offset + i];
                if (neighborId == id) continue;

                vec2 nPos = entities[neighborId].position;
                float nRadius = entities[neighborId].radius;
                
                vec2 diff = pos - nPos;
                float distSq = dot(diff, diff);
                float minDist = radius + nRadius;

                if (distSq > 0.0001 && distSq < minDist * minDist) {
                    float dist = sqrt(distSq);
                    vec2 normal = diff / dist;
                    float overlap = minDist - dist;
                    
                    // Apply repulsion force to velocity
                    vel += normal * overlap * 10.0; // Fixed strength factor
                }
            }
        }
    }

    // 2. Integration
    pos += vel * dt;
    
    // Air resistance/Friction
    vel *= pow(0.92, dt * 60.0);

    // 3. Boundary Collision
    if (pos.x < 0.0) { pos.x = 0.0; vel.x *= -0.5; }
    if (pos.x > 5000.0) { pos.x = 5000.0; vel.x *= -0.5; }
    if (pos.y < 0.0) { pos.y = 0.0; vel.y *= -0.5; }
    if (pos.y > 5000.0) { pos.y = 5000.0; vel.y *= -0.5; }

    // Write back
    entities[id].position = pos;
    entities[id].velocity = vel;
}
</file>

