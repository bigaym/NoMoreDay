{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "@tarquinen/opencode-dcp@latest",
        "opencode-ignore",
        "cc-safety-net",
        "@ramtinj95/opencode-tokenscope@latest"
    ],
    "watcher": {
        "ignore": [
            ".git/**",
            ".vs/**",
            "build/**",
            "bin/**",
            "logs/**",
            "saves/**",
            "assets/generated/**"
        ]
    },
    "mcp": {
        "memory": {
            "type": "local",
            "command": [
                "memory",
                "server"
            ],
            "enabled": true
        },
        "tree_sitter": {
            "type": "local",
            "command": [
                "uvx",
                "mcp-server-tree-sitter"
            ],
            "enabled": false
        },
        "godot-mcp-pro": {
            "type": "local",
            "command": [
                "node",
                "F:/DownLoad/Compressed/godot-mcp-pro-v1.11.0/server/build/index.js",
                "--lite"
            ],
            "environment": {
                "GODOT_MCP_PORT": "6507"
            },
            "enabled": false
        },
        "sequential-thinking": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ],
            "enabled": false
        },
        "clangd_graph_rag": {
            "type": "local",
            "command": [
                "powershell",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "F:\\NoMoreDay\\scripts\\_LaunchClangdGraphRagMcp.ps1"
            ],
            "enabled": false
        },
        "codebase-memory-mcp": {
            "type": "local",
            "enabled": true,
            "command": [
                "C:/Users/yuminao/AppData/Local/Programs/codebase-memory-mcp/codebase-memory-mcp.exe"
            ]
        }
    }
}