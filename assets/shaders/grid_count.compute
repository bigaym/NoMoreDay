#version 430
layout(local_size_x = 256) in;

struct Entity {
    vec2 position;
    vec2 velocity;
    float radius;
    int type;
    int id;
    float padding;
};

layout(std430, binding = 1) buffer EntityBuffer { Entity entities[]; };
layout(std430, binding = 2) buffer CellCountBuffer { uint cellCounts[]; };

uniform int maxEntities;
uniform float cellSize;
uniform int gridCols;
uniform int gridRows;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= maxEntities || entities[id].radius <= 0.0) return;

    int cx = int(entities[id].position.x / cellSize);
    int cy = int(entities[id].position.y / cellSize);
    
    if (cx < 0 || cx >= gridCols || cy < 0 || cy >= gridRows) return;
    
    uint cellIdx = cy * gridCols + cx;
    atomicAdd(cellCounts[cellIdx], 1);
}
