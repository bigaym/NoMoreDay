#version 430

layout(local_size_x = 256) in;

// Must match GPUEntity in GPUData.hpp (64 bytes)
struct Entity {
    vec2 position;     // 8  - Current physics position
    vec2 prevPosition; // 8  - Previous frame position (for render interpolation)
    vec2 velocity;     // 8  - Current velocity
    float radius;      // 4  - Collision radius
    int type;          // 4  - Entity type
    uint flags;        // 4  - Behavior flags
    float padding[7];  // 28 - Padding to 64 bytes
};

layout(std430, binding = 1) buffer InEntityBuffer { Entity inEntities[]; };
layout(std430, binding = 5) buffer OutEntityBuffer { Entity outEntities[]; };
layout(std430, binding = 2) buffer CellCountBuffer { uint cellCounts[]; };
layout(std430, binding = 3) buffer CellOffsetBuffer { uint cellOffsets[]; };
layout(std430, binding = 4) buffer EntityIndicesBuffer { uint entityIndices[]; };
layout(std430, binding = 6) buffer FlowBuffer { vec2 flow[]; };

uniform float dt;
uniform int maxEntities;
uniform float cellSize;
uniform int gridCols;
uniform int gridRows;
uniform float mapBoundary = 5000.0;

uniform int flowWidth;
uniform int flowHeight;
uniform vec2 flowOrigin;
uniform float flowCellSize = 10.0;

// AI State Constants (Must match C++ AIType)
const uint AI_IDLE = 0u;
const uint AI_PATROL = 1u;
const uint AI_CHASE = 2u;
const uint AI_ATTACK = 3u;
const uint AI_FLEE = 4u;
const uint AI_NEMESIS_HUNTER = 5u;
const uint AI_SUPPORT_FLEE_BUFF = 6u;
const uint AI_ASSASSIN_STEALTH = 7u;
const uint AI_TANK_BLOCK = 8u;

bool shouldUseFlowField(uint aiState) {
    return aiState == AI_CHASE ||
           aiState == AI_ATTACK ||
           aiState == AI_NEMESIS_HUNTER ||
           aiState == AI_ASSASSIN_STEALTH ||
           aiState == AI_TANK_BLOCK;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= maxEntities || inEntities[id].radius <= 0.0) {
        // Must copy inactive entities too to maintain parity if needed, 
        // but since we sync from CPU every frame, we just need to ensure 
        // active ones are calculated. 
        // Actually, since we are double buffering, we MUST copy the state 
        // even if we don't update it, or at least zero it out.
        if (id < maxEntities) {
            outEntities[id] = inEntities[id];
        }
        return;
    }

    Entity e = inEntities[id];
    vec2 pos = e.position;
    vec2 vel = e.velocity;
    float radius = e.radius;

    // [INTERPOLATION] Save current position as previous BEFORE physics update
    e.prevPosition = pos;

    // 0. Steering (Flow Field) - Based on AI State (Bits 8-15)
    uint aiState = (e.flags >> 8) & 0xFFu;
    
    // Legacy fallback: also check bit 2 (CHASING) just in case, or solely rely on state.
    // Spec says: "Shield non-aggro state", so we strictly use aiState logic to be safe.
    if (shouldUseFlowField(aiState)) {
        vec2 relativePos = pos - flowOrigin;
        int fx = int(relativePos.x / flowCellSize);
        int fy = int(relativePos.y / flowCellSize);

        if (fx >= 0 && fx < flowWidth && fy >= 0 && fy < flowHeight) {
            uint flowIdx = uint(fy * flowWidth + fx);
            vec2 flowDir = flow[flowIdx];
            if (length(flowDir) > 0.01) {
                float speed = 150.0; 
                float steerForce = 400.0;
                vec2 desiredVel = flowDir * speed;
                vec2 steer = desiredVel - vel;
                vel += steer * steerForce * dt * 0.1; 
            }
        }
    }
    // [FIX] Removed aggressive friction (vel *= 0.90) for non-chase states.
    // This allows CPU-driven velocity (Patrol) to persist without being instantly dampened.

    // 1. Collision Detection (Spatial Hash Grid)
    int cx = int(pos.x / cellSize);
    int cy = int(pos.y / cellSize);

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            int ncx = cx + x;
            int ncy = cy + y;
            if (ncx < 0 || ncx >= gridCols || ncy < 0 || ncy >= gridRows) continue;

            uint cellIdx = ncy * gridCols + ncx;
            uint offset = cellOffsets[cellIdx];
            uint count = cellCounts[cellIdx];

            for (uint i = 0; i < count; i++) {
                uint neighborId = entityIndices[offset + i];
                if (neighborId == id) continue;

                vec2 nPos = inEntities[neighborId].position;
                float nRadius = inEntities[neighborId].radius;
                
                vec2 diff = pos - nPos;
                float distSq = dot(diff, diff);
                float minDist = radius + nRadius;

                if (distSq > 0.0001 && distSq < minDist * minDist) {
                    float dist = sqrt(distSq);
                    vec2 normal = diff / dist;
                    float overlap = minDist - dist;
                    vel += normal * overlap * 10.0; 
                }
            }
        }
    }

    // 2. Integration
    if ((e.flags & 1u) == 0u) {
        pos += vel * dt;
        vel *= pow(0.92, dt * 60.0);

        // 3. Boundary Collision
        if (pos.x < 0.0) { pos.x = 0.0; vel.x *= -0.5; }
        if (pos.x > mapBoundary) { pos.x = mapBoundary; vel.x *= -0.5; }
        if (pos.y < 0.0) { pos.y = 0.0; vel.y *= -0.5; }
        if (pos.y > mapBoundary) { pos.y = mapBoundary; vel.y *= -0.5; }
    }

    // Write back to OUT buffer
    e.position = pos;
    e.velocity = vel;
    outEntities[id] = e;
}
