#version 430

layout(local_size_x = 1) in;

layout(std430, binding = 2) buffer DrawIndirectBuffer {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint baseInstance;
};

layout(std430, binding = 3) buffer AtomicCounterBuffer {
    uint aliveCounter;
};

void main() {
    instanceCount = aliveCounter;
}
