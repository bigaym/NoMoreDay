#version 430

struct GPUVisualStats {
    float weaponDamage;
    float attackSpeed;
    float critChance;
    float critDamage;
    float defenseRating;
    float statusStrength;
    float glowIntensity;
    uint glowColorPacked;
    uint activeStatusMask;
    float statusTimer;
    float padding[6];
};

struct UpdateCmd {
    uint index;
    float pad[3];
    GPUVisualStats stats;
};

layout(std430, binding = 0) readonly buffer Updates {
    UpdateCmd cmds[];
};

layout(std430, binding = 1) writeonly buffer MainStats {
    GPUVisualStats stats[];
};

uniform uint updateCount;

layout(local_size_x = 64) in;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= updateCount) return;

    uint targetIdx = cmds[gid].index;
    stats[targetIdx] = cmds[gid].stats;
}
