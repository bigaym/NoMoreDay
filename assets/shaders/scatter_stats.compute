#version 430
// GPUVisualStats layout is governed by tools/render_abi/abi_manifest.json and
// mirrored into generated/gpu_abi.glslinc. Keep the manifest and GPUData.hpp in
// sync; do not redefine the struct here.
#include "generated/gpu_abi.glslinc"

struct UpdateCmd {
    uint index;
    float pad[3];
    GPUVisualStats stats;
};

layout(std430, binding = 0) readonly buffer Updates {
    UpdateCmd cmds[];
};

layout(std430, binding = 1) writeonly buffer MainStats {
    GPUVisualStats stats[];
};

uniform uint updateCount;

layout(local_size_x = 64) in;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= updateCount) return;

    uint targetIdx = cmds[gid].index;
    stats[targetIdx] = cmds[gid].stats;
}
