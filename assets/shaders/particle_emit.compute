#version 430

layout(local_size_x = 256) in;

struct Particle {
    vec2 position;
    vec2 velocity;
    vec2 acceleration;
    uint color;
    float lifetime;
    float maxLifetime;
    float scale;
    uint flags;
    float growthRate;
    float pad[4];
};

layout(std430, binding = 0) buffer EmissionBuffer {
    Particle emitted[];
};

layout(std430, binding = 1) buffer CompactBuffer {
    Particle compacted[];
};

layout(std430, binding = 2) buffer DrawIndirectBuffer {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint baseInstance;
};

layout(std430, binding = 3) buffer AtomicCounterBuffer {
    uint aliveCounter;
};

uniform int emitCount;

void main() {
    uint id = gl_GlobalInvocationID.x;
    
    if (id >= emitCount) return;
    
    Particle p = emitted[id];
    
    // Append to compact buffer
    uint destIdx = atomicAdd(aliveCounter, 1);
    compacted[destIdx] = p;
    
    // Update instanceCount with the new total after addition
    memoryBarrierBuffer();
}
