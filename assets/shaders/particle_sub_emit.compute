#version 430
#include "generated/gpu_abi.glslinc"

layout(local_size_x = 256) in;

#define Particle GPUParticle

layout(std430, binding = 1) buffer CompactBuffer {
    Particle compacted[];
};

layout(std430, binding = 3) buffer AtomicCounterBuffer {
    uint aliveCounter;
};

layout(std430, binding = 5) readonly buffer SubEmissionBuffer {
    Particle subEmissions[];
};

layout(std430, binding = 6) buffer SubEmitCounter {
    uint subEmitCounter;
};

uniform int subEmitCount;
uniform int maxParticles;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(subEmitCount)) {
        return;
    }

    uint dst = atomicAdd(aliveCounter, 1u);
    if (dst >= uint(maxParticles)) {
        return;
    }

    compacted[dst] = subEmissions[id];
}
