#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer CostBuffer {
    uint cost[];
};

layout(std430, binding = 1) buffer IntegrationBuffer {
    uint integration[];
};

uniform int width;
uniform int height;
uniform ivec2 targetPos;

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    
    if (x >= width || y >= height) return;
    
    uint index = y * width + x;
    
    // Check if this is the target
    if (int(x) == targetPos.x && int(y) == targetPos.y) {
        integration[index] = 0;
    } else {
        // Initialize with Max Int (0xFFFFFFFF)
        integration[index] = 0xFFFFFFFF;
    }
}
