#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f, binding = 4) uniform coherent image2D uEmissiveOut;

uniform sampler2DArray uMaskArray;
uniform ivec2 uResolution;
uniform int uMaskLayer;
uniform ivec2 uDispatchOrigin;
uniform ivec2 uDispatchSize;
uniform vec4 uEmission; // rgb + intensity

void main() {
    ivec2 localPixel = ivec2(gl_GlobalInvocationID.xy);
    if (localPixel.x >= uDispatchSize.x || localPixel.y >= uDispatchSize.y) {
        return;
    }

    ivec2 pixel = uDispatchOrigin + localPixel;
    if (pixel.x < 0 || pixel.y < 0 || pixel.x >= uResolution.x || pixel.y >= uResolution.y) {
        return;
    }

    vec2 uv = (vec2(localPixel) + vec2(0.5)) / vec2(max(uDispatchSize, ivec2(1)));
    vec2 radial = uv * 2.0 - 1.0;
    float radialWeight = clamp(1.0 - dot(radial, radial), 0.0, 1.0);
    float maskAlpha = texture(uMaskArray, vec3(uv, float(uMaskLayer))).a;
    vec3 materialEmission = uEmission.rgb * uEmission.a * maskAlpha * radialWeight;

    vec4 accum = imageLoad(uEmissiveOut, pixel);
    accum.rgb += materialEmission;
    accum.a = 1.0;
    imageStore(uEmissiveOut, pixel, accum);
}
