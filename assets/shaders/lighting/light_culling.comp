#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

uniform int uClusterGridX;
uniform int uClusterGridY;
uniform int uClusterGridZ;
uniform float uTileSizeWorld;
uniform vec2 uCameraOffset;
uniform int uLightCount;
uniform int uMaxLightsPerCluster;
uniform int uMaxTotalClusteredLights;

struct LightData {
    float posX;
    float posY;
    float radius;
    float intensity;
    float colorR;
    float colorG;
    float colorB;
    float colorA;
    float dirX;
    float dirY;
    float spotCosHalfAngle;
    uint lightType;
};

struct ClusterHeaderData {
    uint offset;
    uint count;
    uint overflowCount;
    uint reserved;
};

struct ClusterLightIndexData {
    uint lightIndex;
};

struct LightBoundsData {
    vec2 minXY;
    vec2 maxXY;
    float minLayer;
    float maxLayer;
    uint lightIndex;
    uint priority;
};

layout(std430, binding = 0) readonly buffer LightBuffer {
    LightData lights[];
} gLightBuffer;

layout(std430, binding = 1) buffer ClusterHeaderBuffer {
    ClusterHeaderData headers[];
} gClusterHeaderBuffer;

layout(std430, binding = 2) buffer ClusterIndexBuffer {
    ClusterLightIndexData indices[];
} gClusterIndexBuffer;

layout(std430, binding = 3) readonly buffer LightBoundsBuffer {
    LightBoundsData bounds[];
} gLightBoundsBuffer;

layout(std430, binding = 4) buffer ClusterCounterBuffer {
    uint writeCursor;
} gClusterCounterBuffer;

const int kRenderLayerMin = -32;
const int kRenderLayerSpan = 64;
const uint kSpotLightType = 1u;
const uint kSelectionArraySize = 64u;

bool IntersectsAabb(vec2 aMin, vec2 aMax, vec2 bMin, vec2 bMax) {
    return aMax.x >= bMin.x && aMin.x <= bMax.x && aMax.y >= bMin.y && aMin.y <= bMax.y;
}

bool IntersectsLayer(float lightMinLayer, float lightMaxLayer, int clusterMinLayer, int clusterMaxLayer) {
    return lightMaxLayer >= float(clusterMinLayer) && lightMinLayer <= float(clusterMaxLayer);
}

void ComputeClusterLayerRange(uint slice, int sliceCount, out int outMinLayer, out int outMaxLayer) {
    if (sliceCount <= 0) {
        outMinLayer = kRenderLayerMin;
        outMaxLayer = kRenderLayerMin;
        return;
    }

    int start = int((slice * uint(kRenderLayerSpan)) / uint(sliceCount));
    int endExclusive = int((((slice + 1u) * uint(kRenderLayerSpan)) + uint(sliceCount) - 1u) / uint(sliceCount));
    outMinLayer = kRenderLayerMin + start;
    outMaxLayer = (kRenderLayerMin + endExclusive) - 1;
}

bool IntersectsFine(in LightData light, vec2 clusterMin, vec2 clusterMax) {
    vec2 lightPos = vec2(light.posX, light.posY);
    vec2 closest = clamp(lightPos, clusterMin, clusterMax);
    vec2 delta = lightPos - closest;
    float radius = max(light.radius, 0.0);
    if (dot(delta, delta) > (radius * radius)) {
        return false;
    }

    if (light.lightType == kSpotLightType) {
        vec2 center = (clusterMin + clusterMax) * 0.5;
        vec2 toCenter = center - lightPos;
        float toCenterLenSq = dot(toCenter, toCenter);
        if (toCenterLenSq <= 1e-8) {
            return true;
        }
        vec2 lightDir = normalize(vec2(light.dirX, light.dirY));
        vec2 toCenterDir = normalize(toCenter);
        float cone = dot(lightDir, toCenterDir);
        if (cone < light.spotCosHalfAngle) {
            return false;
        }
    }
    return true;
}

bool IsBetterCandidate(uint lhsPriority, float lhsIntensity, uint lhsIndex,
                       uint rhsPriority, float rhsIntensity, uint rhsIndex) {
    if (lhsPriority != rhsPriority) {
        return lhsPriority > rhsPriority;
    }
    if (lhsIntensity != rhsIntensity) {
        return lhsIntensity > rhsIntensity;
    }
    return lhsIndex < rhsIndex;
}

void main() {
    if (uClusterGridX <= 0 || uClusterGridY <= 0 || uClusterGridZ <= 0 ||
        uTileSizeWorld <= 0.0 || uMaxLightsPerCluster <= 0 || uMaxTotalClusteredLights <= 0) {
        return;
    }

    uvec3 gid = gl_GlobalInvocationID;
    uint clusterX = gid.x;
    uint clusterY = gid.y;
    uint clusterZ = gid.z;

    if (clusterX >= uint(uClusterGridX) || clusterY >= uint(uClusterGridY) ||
        clusterZ >= uint(uClusterGridZ)) {
        return;
    }

    uint clusterId = clusterX +
                     clusterY * uint(uClusterGridX) +
                     clusterZ * uint(uClusterGridX) * uint(uClusterGridY);

    vec2 clusterMin = uCameraOffset + vec2(clusterX, clusterY) * uTileSizeWorld;
    vec2 clusterMax = clusterMin + vec2(uTileSizeWorld, uTileSizeWorld);

    int clusterMinLayer = kRenderLayerMin;
    int clusterMaxLayer = kRenderLayerMin;
    ComputeClusterLayerRange(clusterZ, uClusterGridZ, clusterMinLayer, clusterMaxLayer);

    uint selectedIndices[kSelectionArraySize];
    uint selectedPriorities[kSelectionArraySize];
    float selectedIntensities[kSelectionArraySize];
    uint selectedCount = 0u;
    uint overflowCount = 0u;
    uint maxPerCluster = min(uint(uMaxLightsPerCluster), kSelectionArraySize);

    uint lightCount = max(0, uLightCount);
    for (uint i = 0u; i < lightCount; ++i) {
        LightBoundsData coarse = gLightBoundsBuffer.bounds[i];
        if (!IntersectsAabb(coarse.minXY, coarse.maxXY, clusterMin, clusterMax)) {
            continue;
        }
        if (!IntersectsLayer(coarse.minLayer, coarse.maxLayer, clusterMinLayer, clusterMaxLayer)) {
            continue;
        }

        uint lightIndex = coarse.lightIndex;
        if (lightIndex >= lightCount) {
            continue;
        }

        LightData light = gLightBuffer.lights[lightIndex];
        if (light.intensity <= 0.0 || light.radius <= 0.0) {
            continue;
        }
        if (!IntersectsFine(light, clusterMin, clusterMax)) {
            continue;
        }

        uint candidatePriority = coarse.priority;
        float candidateIntensity = light.intensity;
        uint insertPos = selectedCount;
        while (insertPos > 0u) {
            uint prev = insertPos - 1u;
            if (!IsBetterCandidate(candidatePriority, candidateIntensity, lightIndex,
                                   selectedPriorities[prev], selectedIntensities[prev],
                                   selectedIndices[prev])) {
                break;
            }
            insertPos = prev;
        }

        if (selectedCount < maxPerCluster) {
            for (uint move = selectedCount; move > insertPos; --move) {
                selectedIndices[move] = selectedIndices[move - 1u];
                selectedPriorities[move] = selectedPriorities[move - 1u];
                selectedIntensities[move] = selectedIntensities[move - 1u];
            }
            selectedIndices[insertPos] = lightIndex;
            selectedPriorities[insertPos] = candidatePriority;
            selectedIntensities[insertPos] = candidateIntensity;
            ++selectedCount;
        } else if (maxPerCluster > 0u && insertPos < maxPerCluster) {
            for (uint move = maxPerCluster - 1u; move > insertPos; --move) {
                selectedIndices[move] = selectedIndices[move - 1u];
                selectedPriorities[move] = selectedPriorities[move - 1u];
                selectedIntensities[move] = selectedIntensities[move - 1u];
            }
            selectedIndices[insertPos] = lightIndex;
            selectedPriorities[insertPos] = candidatePriority;
            selectedIntensities[insertPos] = candidateIntensity;
            ++overflowCount;
        } else {
            ++overflowCount;
        }
    }

    uint writeCount = selectedCount;
    uint writeOffset = atomicAdd(gClusterCounterBuffer.writeCursor, writeCount);

    uint clampedWriteCount = 0u;
    if (writeOffset < uint(uMaxTotalClusteredLights)) {
        clampedWriteCount = min(writeCount, uint(uMaxTotalClusteredLights) - writeOffset);
    }
    overflowCount += (writeCount - clampedWriteCount);

    ClusterHeaderData header;
    header.offset = writeOffset;
    header.count = clampedWriteCount;
    header.overflowCount = overflowCount;
    header.reserved = 0u;
    gClusterHeaderBuffer.headers[clusterId] = header;

    for (uint i = 0u; i < clampedWriteCount; ++i) {
        gClusterIndexBuffer.indices[writeOffset + i].lightIndex = selectedIndices[i];
    }
}

