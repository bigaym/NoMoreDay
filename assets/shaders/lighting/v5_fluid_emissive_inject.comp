#version 430 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct FluidParticle {
    vec2 position;
    vec2 velocity;
    float density;
    float pressure;
    vec4 color;
    float lifetime;
    uint flags;
};

layout(std430, binding = 0) readonly buffer ParticlesIn {
    FluidParticle particles[];
};

layout(rgba16f, binding = 4) uniform image2D uEmissiveOut;

uniform int uParticleCount;
uniform ivec2 uResolution;
uniform vec2 uCameraOffset;
uniform vec2 uScreenSize;
uniform float uThreshold;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uint(max(uParticleCount, 0))) {
        return;
    }

    FluidParticle p = particles[idx];
    if (p.color.w < uThreshold || uResolution.x <= 0 || uResolution.y <= 0) {
        return;
    }

    vec2 uv = (p.position - uCameraOffset) / max(uScreenSize, vec2(0.0001));
    ivec2 pixel = ivec2(floor(uv * vec2(uResolution)));
    if (pixel.x < 0 || pixel.y < 0 || pixel.x >= uResolution.x || pixel.y >= uResolution.y) {
        return;
    }

    vec4 prev = imageLoad(uEmissiveOut, pixel);
    vec3 emission = p.color.rgb * p.color.w * 0.35;
    imageStore(uEmissiveOut, pixel, vec4(max(prev.rgb, emission), 1.0));
}

