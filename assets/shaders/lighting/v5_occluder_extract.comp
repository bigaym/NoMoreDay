#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer ShadowCasterWords {
    vec4 casterWords[];
};

layout(r8, binding = 0) uniform writeonly image2D uOccluderMaskOut;

uniform ivec2 uResolution;
uniform int uOccluderCount;
uniform vec2 uCameraOffset;
uniform vec2 uScreenSize;
uniform int uDynamicOnly; // 0 = static only, 1 = dynamic only

bool includeCaster(uint dynamicFlag) {
    if (uDynamicOnly != 0) {
        return dynamicFlag != 0u;
    }
    return dynamicFlag == 0u;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= uResolution.x || pixel.y >= uResolution.y) {
        return;
    }

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(uResolution);
    vec2 worldPos = uCameraOffset + uv * uScreenSize;

    float occupied = 0.0;
    for (int i = 0; i < uOccluderCount; ++i) {
        vec4 caster0 = casterWords[i * 2];
        vec4 caster1 = casterWords[i * 2 + 1];
        uint dynamicFlag = floatBitsToUint(caster1.y);
        if (!includeCaster(dynamicFlag)) {
            continue;
        }

        vec2 center = caster0.xy;
        float radius = max(caster0.z, 0.001);
        if (distance(worldPos, center) <= radius) {
            occupied = 1.0;
            break;
        }
    }

    imageStore(uOccluderMaskOut, pixel, vec4(occupied, 0.0, 0.0, 1.0));
}
