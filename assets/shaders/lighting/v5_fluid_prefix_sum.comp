#version 430 core

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer CellCounts {
    uint cellCounts[];
};

layout(std430, binding = 1) writeonly buffer CellStarts {
    uint cellStarts[];
};

layout(std430, binding = 2) writeonly buffer CellEnds {
    uint cellEnds[];
};

layout(std430, binding = 3) writeonly buffer CellOffsets {
    uint cellOffsets[];
};

uniform int uTotalCells;

void main() {
    uint count = uint(max(uTotalCells, 0));
    uint sum = 0u;
    for (uint i = 0u; i < count; ++i) {
        cellStarts[i] = sum;
        sum += cellCounts[i];
        cellEnds[i] = sum;
        cellOffsets[i] = 0u;
    }
}
