#version 430
layout(local_size_x = 16, local_size_y = 16) in;

// Visibility states (must match C++ constants)
const uint VISIBILITY_UNEXPLORED = 0u;
const uint VISIBILITY_EXPLORED = 1u;
const uint VISIBILITY_VISIBLE = 2u;

// Visibility grid (read/write)
layout(std430, binding = 0) buffer VisibilityBuffer {
    uint visibility[];
};

// Output texture (RGBA8, written directly)
layout(rgba8, binding = 0) uniform writeonly image2D fogTexture;

uniform int width;
uniform int height;
uniform vec4 viewRect;  // Visible screen rect in grid coords: (minX, minY, maxX, maxY)

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    
    if (x >= width || y >= height) return;
    
    uint index = y * width + x;
    uint currentVis = visibility[index];
    
    // Check if the tile is inside the visible screen rect
    bool insideRect = float(x) >= viewRect.x && float(x) <= viewRect.z &&
                      float(y) >= viewRect.y && float(y) <= viewRect.w;
    
    // Update visibility based on screen rect
    if (insideRect) {
        // Within the visible screen area - set to VISIBLE
        visibility[index] = VISIBILITY_VISIBLE;
        currentVis = VISIBILITY_VISIBLE;
    } else if (currentVis == VISIBILITY_VISIBLE) {
        // Was visible, now out of the screen - downgrade to EXPLORED
        visibility[index] = VISIBILITY_EXPLORED;
        currentVis = VISIBILITY_EXPLORED;
    }
    // EXPLORED and UNEXPLORED remain unchanged
    
    // Write to fog texture
    vec4 fogColor;
    switch (currentVis) {
        case VISIBILITY_UNEXPLORED:
            fogColor = vec4(0.0, 0.0, 0.0, 1.0);  // Full black
            break;
        case VISIBILITY_EXPLORED:
            fogColor = vec4(0.2, 0.2, 0.2, 0.7);  // Dark gray, semi-transparent
            break;
        case VISIBILITY_VISIBLE:
            fogColor = vec4(0.0, 0.0, 0.0, 0.0);  // Fully transparent
            break;
        default:
            fogColor = vec4(0.0, 0.0, 0.0, 1.0);
            break;
    }
    
    imageStore(fogTexture, ivec2(x, y), fogColor);
}
