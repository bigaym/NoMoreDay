#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 1) readonly buffer IntegrationBuffer {
    uint integration[];
};

layout(std430, binding = 2) writeonly buffer FlowBuffer {
    vec2 flow[];
};

uniform int width;
uniform int height;

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    
    if (x >= width || y >= height) return;
    uint index = y * width + x;

    uint myDist = integration[index];
    if (myDist == 0xFFFFFFFF) {
        flow[index] = vec2(0.0);
        return;
    }

    // Helper to get distance safely
    // If neighbor is out of bounds or wall (0xFFFFFFFF), treat as HIGH COST to repel
    // Reduced penalty to 50 (from 65535) so it doesn't drown out the path gradient
    uint penalty = myDist + 50;

    // Left (x-1)
    uint leftDist = penalty;
    if (int(x) > 0) {
        uint val = integration[index - 1];
        if (val != 0xFFFFFFFF) leftDist = val;
    }

    // Right (x+1)
    uint rightDist = penalty;
    if (int(x) < width - 1) {
        uint val = integration[index + 1];
        if (val != 0xFFFFFFFF) rightDist = val;
    }

    // Up (y-1)
    uint upDist = penalty;
    if (int(y) > 0) {
        uint val = integration[(y - 1) * width + x];
        if (val != 0xFFFFFFFF) upDist = val;
    }

    // Down (y+1)
    uint downDist = penalty;
    if (int(y) < height - 1) {
        uint val = integration[(y + 1) * width + x];
        if (val != 0xFFFFFFFF) downDist = val;
    }

    // Calculate Gradient (Steepest Descent)
    // V = -Grad(D)
    // dx = Left - Right
    // dy = Up - Down
    
    // Note: casts to int or float are needed to avoid underflow
    float dx = float(leftDist) - float(rightDist);
    float dy = float(upDist) - float(downDist);

    vec2 dir = vec2(dx, dy);

    if (length(dir) > 0.001) {
        dir = normalize(dir);
    }
    
    flow[index] = dir;
}
