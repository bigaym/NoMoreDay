#version 430
layout(local_size_x = 16, local_size_y = 16) in;
layout(r32ui, binding = 0) uniform uimage2D integrationImg;
layout(rg16f, binding = 2) uniform image2D flowImg; // Vector output

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(integrationImg);
    if (coord.x >= size.x || coord.y >= size.y) return;

    uint currentDist = imageLoad(integrationImg, coord).r;
    if (currentDist == 65535) {
        imageStore(flowImg, coord, vec4(0.0, 0.0, 0.0, 0.0));
        return;
    }

    vec2 flow = vec2(0.0);
    uint minDist = currentDist;

    // Check 8 neighbors to find gradient descent
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            if (x == 0 && y == 0) continue;
            
            ivec2 nCoord = coord + ivec2(x, y);
            if (nCoord.x >= 0 && nCoord.y >= 0 && nCoord.x < size.x && nCoord.y < size.y) {
                uint nDist = imageLoad(integrationImg, nCoord).r;
                // If neighbor is closer to target
                if (nDist < minDist) {
                    minDist = nDist;
                    flow = vec2(x, y);
                }
            }
        }
    }

    if (length(flow) > 0.0) {
        flow = normalize(flow);
    }
    
    imageStore(flowImg, coord, vec4(flow, 0.0, 0.0));
}
