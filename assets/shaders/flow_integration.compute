#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer CostBuffer {
    uint cost[];
};

layout(std430, binding = 1) buffer IntegrationBuffer {
    uint integration[];
};

uniform int width;
uniform int height;

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    
    if (x >= width || y >= height) return;
    uint index = y * width + x;

    uint myCost = cost[index];
    if (myCost >= 255) return; // Wall
    
    // Ensure minimum cost to avoid zero-cost cycles, assuming 1 is base cost
    myCost = max(myCost, 1u);

    uint currentDist = integration[index];
    uint minDist = currentDist;

    // Check 8 neighbors
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            if (dx == 0 && dy == 0) continue;
            
            int nx = int(x) + dx;
            int ny = int(y) + dy;
            
            if (nx >= 0 && nx < width && ny >= 0 && ny < height) {
                uint nIndex = ny * width + nx;
                uint nDist = integration[nIndex];
                
                if (nDist != 0xFFFFFFFF) {
                    // Cardinal: 10, Diagonal: 14
                    uint weight = (dx == 0 || dy == 0) ? 10u : 14u;
                    uint moveCost = myCost * weight;
                    uint newDist = nDist + moveCost;
                    
                    if (newDist < minDist) {
                        minDist = newDist;
                    }
                }
            }
        }
    }

    if (minDist < currentDist) {
        integration[index] = minDist;
    }
}
