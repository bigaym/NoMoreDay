#version 430
layout(local_size_x = 16, local_size_y = 16) in;
layout(r32ui, binding = 0) uniform uimage2D integrationImg;
layout(r8ui, binding = 1) uniform uimage2D costImg;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(integrationImg);
    if (coord.x >= size.x || coord.y >= size.y) return;

    uint cost = imageLoad(costImg, coord).r;
    if (cost == 255) return; // Wall

    uint currentDist = imageLoad(integrationImg, coord).r;
    uint minDist = currentDist;

    // Check 4 neighbors
    const ivec2 offsets[4] = {ivec2(1,0), ivec2(-1,0), ivec2(0,1), ivec2(0,-1)};
    
    for(int i=0; i<4; i++) {
        ivec2 nCoord = coord + offsets[i];
        if (nCoord.x >= 0 && nCoord.y >= 0 && nCoord.x < size.x && nCoord.y < size.y) {
            uint nDist = imageLoad(integrationImg, nCoord).r;
            // Cost accumulation
            if (nDist != 65535 && nDist + cost < minDist) {
                minDist = nDist + cost;
            }
        }
    }

    if (minDist < currentDist) {
        imageStore(integrationImg, coord, uvec4(minDist));
    }
}
