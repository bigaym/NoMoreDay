#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer CostBuffer {
    uint cost[];
};

layout(std430, binding = 1) readonly buffer IntegrationRead {
    uint integrationRead[];
};

layout(std430, binding = 4) writeonly buffer IntegrationWrite {
    uint integrationWrite[];
};

layout(std430, binding = 3) readonly buffer DensityBuffer {
    uint density[];
};

uniform int width;
uniform int height;
uniform float densityWeight = 5.0;

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    
    if (x >= width || y >= height) return;
    uint index = y * width + x;

    uint myCost = cost[index];
    if (myCost >= 255) {
        integrationWrite[index] = 0xFFFFFFFF;
        return;
    }
    
    // Add crowd density to cost
    myCost += uint(float(density[index]) * densityWeight);
    
    myCost = max(myCost, 1u);

    uint currentDist = integrationRead[index];
    uint minDist = currentDist;

    // Check 8 neighbors
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            if (dx == 0 && dy == 0) continue;
            
            int nx = int(x) + dx;
            int ny = int(y) + dy;
            
            if (nx >= 0 && nx < width && ny >= 0 && ny < height) {
                uint nIndex = ny * width + nx;
                uint nDist = integrationRead[nIndex];
                
                if (nDist != 0xFFFFFFFF) {
                    uint weight = (dx == 0 || dy == 0) ? 1u : 1u;
                    uint moveCost = myCost * weight;
                    uint newDist = nDist + moveCost;
                    
                    if (newDist < minDist) {
                        minDist = newDist;
                    }
                }
            }
        }
    }

    integrationWrite[index] = minDist;
}
