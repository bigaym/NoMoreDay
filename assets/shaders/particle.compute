#version 430

layout(local_size_x = 256) in;

struct Particle {
    vec2 position;
    vec2 velocity;
    vec2 acceleration;
    uint color;
    float lifetime;
    float maxLifetime;
    float scale;
    uint flags;
    float growthRate;
    float pad[4]; 
};

// Double-Buffer Bindings
layout(std430, binding = 10) buffer InputBuffer {
    Particle inParticles[];
};

layout(std430, binding = 11) buffer OutputBuffer {
    Particle outParticles[];
};

// Atomic counter for compaction
layout(std430, binding = 12) buffer AtomicBuffer {
    uint aliveCount;
};

uniform float dt;
uniform int maxParticles;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= maxParticles) return;

    Particle p = inParticles[id];

    if (p.lifetime > 0.0) {
        // Physics logic (Minimal & Fast)
        p.velocity += p.acceleration * dt;
        p.velocity *= (1.0 - 0.5 * dt); // Minimal drag
        p.position += p.velocity * dt;
        
        p.scale += p.growthRate * dt;
        if (p.scale < 0.0) p.scale = 0.0;

        p.lifetime -= dt;

        // If still alive, compact it into the OutputBuffer
        if (p.lifetime > 0.0 && p.scale > 0.01) {
            uint destIdx = atomicAdd(aliveCount, 1);
            if (destIdx < maxParticles) {
                outParticles[destIdx] = p;
            }
        }
    }
}
