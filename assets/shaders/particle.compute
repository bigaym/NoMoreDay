#version 430

layout(local_size_x = 256) in;

struct Particle {
    vec2 position;
    vec2 velocity;
    vec2 acceleration;
    uint color;
    float lifetime;
    float maxLifetime;
    float scale;
    uint flags;
    float growthRate;
};

layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

uniform float dt;
uniform int maxParticles;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= maxParticles) return;

    if (particles[id].lifetime > 0.0) {
        // Update velocity with acceleration
        particles[id].velocity += particles[id].acceleration * dt;

        // Update position
        particles[id].position += particles[id].velocity * dt;
        
        // Apply simple air resistance/damping (Drag)
        // Can make this flag dependent later
        particles[id].velocity *= pow(0.95, dt * 60.0); 

        // Update scale (using growthRate)
        particles[id].scale += particles[id].growthRate * dt;
        if (particles[id].scale < 0.0) particles[id].scale = 0.0;

        // Update lifetime
        particles[id].lifetime -= dt;

        if (particles[id].lifetime <= 0.0) {
            particles[id].lifetime = 0.0;
            particles[id].scale = 0.0;
        }
    }
}
