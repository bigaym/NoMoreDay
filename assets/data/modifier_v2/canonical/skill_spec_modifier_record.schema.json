{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nomoreday.local/schemas/modifier/skill_spec_modifier_record.schema.json",
  "title": "Canonical Skill Spec Modifier Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "modifier_id",
    "domain",
    "operation",
    "stat_path",
    "value",
    "stacks",
    "tags",
    "conditions"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "record_type": {
      "type": "string",
      "const": "modifier"
    },
    "modifier_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "domain": {
      "type": "string",
      "enum": [
        "skill_spec"
      ]
    },
    "operation": {
      "type": "string",
      "enum": [
        "add",
        "mul"
      ]
    },
    "stat_path": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_.]*$"
    },
    "value": {
      "type": "number",
      "minimum": -1000.0,
      "maximum": 1000.0
    },
    "stacks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "minLength": 3,
        "maxLength": 24
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_skill_ids",
        "min_player_level"
      ],
      "properties": {
        "all_skill_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        },
        "min_player_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    }
  }
}
